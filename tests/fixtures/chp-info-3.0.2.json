{
 "spec": "chp/2",
 "plugin": {
  "id": "hamdraw_chp",
  "label": {
   "zh": "CHP 插件（ComfyUI Haminn Protocol）",
   "en": "CHP plugin (ComfyUI Haminn Protocol)"
  },
  "version": "3.0.2"
 },
 "auth": {
  "required": true,
  "authorized": true,
  "scheme": "Bearer",
  "header": "Authorization",
  "hint": "密码在 ComfyUI 的 CHP 插件配置节点里设置。"
 },
 "endpoints": {
  "info": "/chp/info",
  "jobs": "/chp/jobs",
  "job": "/chp/jobs/{job_id}",
  "progress": "/chp/jobs/{job_id}/progress",
  "output": "/chp/jobs/{job_id}/output/{index}",
  "cancel": "/chp/jobs/{job_id}/cancel",
  "translate": "/chp/translate"
 },
 "rules": [
  {
   "category": "fast",
   "rule": "txt-ref-2-img",
   "signature": "txt-ref-2-img",
   "input": "txt-ref-2-img/v1",
   "label": {
    "zh": "快速生图",
    "en": "Quick draw"
   },
   "description": {
    "zh": "把画布当作参考图重绘一张 512 × 512 的速写稿。",
    "en": "Redraw the canvas as a 512 × 512 sketch."
   },
   "needs": {
    "prompt": true,
    "image": true,
    "mask": false
   },
   "prompt": {
    "language": "en"
   },
   "defaults": {
    "ref_strength": 0.55
   },
   "typical_seconds": 1.2
  },
  {
   "category": "inpaint",
   "rule": "txt-msk-ref-2-img",
   "signature": "txt-msk-ref-2-img",
   "input": "txt-msk-ref-2-img/v1",
   "label": {
    "zh": "局部重绘",
    "en": "Local redraw"
   },
   "description": {
    "zh": "只重画白色蒙版覆盖的区域, 其余部分原样保留。",
    "en": "Repaint only the white mask area and keep everything else."
   },
   "needs": {
    "prompt": true,
    "image": true,
    "mask": true
   },
   "prompt": {
    "language": "en"
   },
   "defaults": {
    "ref_strength": 0.3
   },
   "typical_seconds": 2.6
  },
  {
   "category": "upscale",
   "rule": "txt-ref-2-img",
   "signature": "txt-ref-2-img",
   "input": "txt-ref-2-img/v1",
   "label": {
    "zh": "图像放大",
    "en": "Upscale"
   },
   "description": {
    "zh": "把画布放大到 1024 或 2048 并补细节。",
    "en": "Upscale the canvas to 1024 or 2048 and add detail."
   },
   "needs": {
    "prompt": true,
    "image": true,
    "mask": false
   },
   "prompt": {
    "language": "en"
   },
   "defaults": {
    "ref_strength": 0.75
   },
   "typical_seconds": 6.0
  },
  {
   "category": "render",
   "rule": "txt-ref-2-img",
   "signature": "txt-ref-2-img",
   "input": "txt-ref-2-img/v1",
   "label": {
    "zh": "高质量生图",
    "en": "High quality render"
   },
   "description": {
    "zh": "重画成一张 1024 以内的成品图。比速写模型重得多, 单张要几十秒。",
    "en": "Repaint the canvas into a finished picture up to 1024 px. Far heavier than a sketch model."
   },
   "needs": {
    "prompt": true,
    "image": false,
    "mask": false
   },
   "prompt": {
    "language": "any"
   },
   "defaults": {
    "ref_strength": 0.95
   },
   "typical_seconds": 45.0
  }
 ],
 "abilities": [
  {
   "name": "DreamShaper8_LCM.safetensors",
   "files": {
