     "title": {
      "zh": "分辨率",
      "en": "Resolution"
     },
     "help": {
      "zh": "输出分辨率, 写成 \"宽x高\"(如 \"768x1344\")。只能取该类别帧表里列出的值; 省略取该类别第一档。",
      "en": "Output resolution as \"WxH\" (e.g. \"768x1344\"). Only the values in that category's frames; omitted takes the first."
     }
    },
    "prompt": {
     "type": "string",
     "default": "",
     "title": {
      "zh": "提示词",
      "en": "Prompt"
     },
     "help": {
      "zh": "画面描述。是否需要先译成英文由 rules[].prompt.language 决定。",
      "en": "What to draw. Whether it must be English first is the rule's prompt.language."
     }
    },
    "seed": {
     "type": "integer",
     "minimum": 0,
     "default": 0,
     "recommended": true,
     "title": {
      "zh": "随机种子",
      "en": "Seed"
     },
     "help": {
      "zh": "0 表示每张都不一样; 同一个值可以复现。",
      "en": "0 means a new seed each run; the same value reproduces."
     }
    },
    "ref_strength": {
     "type": "number",
     "minimum": 0.05,
     "maximum": 0.95,
     "title": {
      "zh": "参考图权重",
      "en": "Reference influence"
     },
     "help": {
      "zh": "0.05–0.95, 越大越贴近参考图, 越低越放手重画。越界会被夹到边界。",
      "en": "0.05–0.95. Higher stays closer to the reference, lower redraws more freely. Out of range is clamped."
     }
    },
    "image_base64": {
     "type": "string",
     "format": "base64-image",
     "title": {
      "zh": "参考图",
      "en": "Reference"
     },
     "help": {
      "zh": "参考图, PNG/JPEG 的 base64, 可直接给 data URL。",
      "en": "Reference image as base64 PNG/JPEG; a data URL is accepted as-is."
     }
    },
    "mask_base64": {
     "type": "string",
     "format": "base64-image",
     "title": {
      "zh": "蒙版",
      "en": "Mask"
     },
     "help": {
      "zh": "蒙版, 黑底白区, 白色 = 要重画。",
      "en": "Mask, black background with a white area; white means repaint."
     }
    },
    "ext_params": {
     "type": "object",
     "additionalProperties": true,
     "default": {},
     "title": {
      "zh": "模型扩展参数",
      "en": "Model extensions"
     },
     "help": {
      "zh": "模型层的扩展参数, 原样携带、原样回显。规范不定义任何字段。",
      "en": "Model-layer extension parameters, carried and echoed verbatim. The spec defines no field in it."
     }
    },
    "chp_params": {
     "type": "object",
     "additionalProperties": true,
     "default": {},
     "title": {
      "zh": "CHP 扩展参数",
      "en": "CHP extensions"
     },
     "help": {
      "zh": "CHP 层的扩展参数。目前只有 password。",
      "en": "CHP-layer extension parameters. Today only password."
     }
    },
    "request_id": {
     "type": "string",
     "maxLength": 200,
     "title": {
      "zh": "提交编号",
      "en": "Request id"
     },
     "help": {
      "zh": "可选。这次提交自己的编号, 由客户端生成。重发同一次提交时沿用同一个值, 服务端就还你**原来那个作业**, 不会再排一个; 换了内容就要换一个值。",
      "en": "Optional. The client's own id for this submission. Send the same value when retrying the same submission and the server answers with the original job instead of queueing a second one; use a new value when the content changes."
     }
    }
   }
  }
 },
 "translation": {
  "available": true,
  "mode": "auto-on-submit",
  "target": "en",
  "backend": {
   "style": "openai-chat-completions",
   "model": "qwen3-0.6b"
  },
  "memory": {
   "schema": "chp-translation-memory/v1",
   "entries": 93,
   "limit": 4000
  },
  "rule": "提示词只含 ASCII 时原样提交, 不发起翻译"
 },
 "errors": [
  "bad_image",
  "bad_mask",
  "bad_request",
  "busy",
  "duplicate_request",
  "internal",
  "invalid_workflow",
  "no_model",
  "not_found",
  "stretched_reference",
  "unauthorized",
  "unsupported_category",
  "unsupported_size",
  "unsupported_steps"
 ]
}
